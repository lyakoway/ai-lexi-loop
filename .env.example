# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Application environment: dev | staging | production.
# In production a Telegram bot token becomes mandatory and the app refuses
# to start without it.
ENVIRONMENT=dev

# PostgreSQL connection string. Both postgresql:// and postgresql+asyncpg://
# schemes are accepted; the asyncpg driver is used either way.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_lexi_loop

# Telegram bot token from @BotFather. Optional outside production: without it
# the bot is disabled and only the HTTP API starts.
TELEGRAM_BOT_TOKEN=

# HTTP server binding.
HOST=0.0.0.0
PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# Test mode: disables Telegram polling and other side effects. Used by tests.
TESTING=false

# LLM integration (Stage 6). Leave LLM_ENABLED=false to run the product
# without AI features. When enabled, every setting below is required and
# validated at startup. The endpoint is OpenAI-compatible: OpenAI,
# OpenRouter, Ollama, vLLM and similar all work without code changes.
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=1024
